# Copy to .env (chmod 600) and fill in. Never commit or share .env.

# Default routing backend: Google Routes API (transit). Enable the "Routes API" in Google Cloud and create a key
# restricted to it. Leave empty if you use your own ROUTER_MODULE instead.
GOOGLE_API_KEY=

# Paid calls allowed per calendar month; the server refuses more (cached answers are always free).
GOOGLE_MONTHLY_LIMIT=2000

# Optional: AI-generated photo check on listing pages (Sightengine "genai" model, https://sightengine.com).
# Each scanned photo is one operation; the free plan includes 2000/month. Cached photos are never scanned twice.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
SIGHTENGINE_MONTHLY_LIMIT=1500

# Optional but recommended when the server is reachable by others: a shared secret (e.g. `openssl rand -hex 24`).
# Every request except /health must then carry it; each user types it into the extension's options.
ACCESS_TOKEN=

# Optional: use your own routing backend instead of Google (see docs/backend-api.md and routers/example-router.mjs).
# ROUTER_MODULE=/routers/my-router.mjs

# Optional: contact (e.g. an email) added to the User-Agent sent to OpenStreetMap services, as their usage policies
# ask. Leave empty to omit.
GATEWAY_CONTACT=
