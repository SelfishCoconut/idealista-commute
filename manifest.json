{
  "manifest_version": 3,
  "name": "Idealista Commute",
  "version": "1.0.0",
  "description": "Shows the public-transport commute time, steps and a map to your workplace on every idealista listing, and sorts results by it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "idealista-commute@selfishcoconut.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://127.0.0.1:8085/*",
    "http://localhost:8085/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Idealista Commute",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "map.html",
        "lib/idealista.js"
      ],
      "matches": [
        "https://www.idealista.com/*"
      ]
    }
  ]
}
